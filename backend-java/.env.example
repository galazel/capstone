# Copy this file to backend-java/.env locally or pass variables in your environment.
# Do not commit backend-java/.env to version control.

# Database Connection (Neon PostgreSQL)
DB_HOST=ep-super-queen-ao83rfhj-pooler.c-2.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=rebyu
DB_USERNAME=neondb_owner
DB_PASSWORD=your_db_password
DB_URL=jdbc:postgresql://ep-super-queen-ao83rfhj-pooler.c-2.ap-southeast-1.aws.neon.tech:5432/rebyu?sslmode=require

# AWS S3 & Cognito Authentication
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_QGbFDQKL3
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_QGbFDQKL3
COGNITO_CLIENT_ID=your_cognito_client_id
COGNITO_CLIENT_SECRET=your_cognito_client_secret

# External APIs & Services
GITHUB_TOKEN=your_github_token
GOOGLE_APP_PASS=your_google_app_password
GROQ_API_KEY=your_groq_api_key
YOUTUBE_API_KEY=your_youtube_api_key
SERPER_API_KEY=your_serper_api_key
PAYMONGO_ENABLED=false
PAYMONGO_SECRET_KEY=replace_with_your_paymongo_test_secret_key
PAYMONGO_PUBLIC_KEY=replace_with_your_paymongo_test_public_key
