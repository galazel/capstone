# Copy this file to backend-java/.env and fill in the values.
# The app loads it at startup (see DotenvEnvironmentPostProcessor); real shell /
# IDE / deployment environment variables always win over what is in .env.
# Do not commit backend-java/.env.

# --- Database (required) ---
DB_URL=jdbc:postgresql://localhost:5432/rebyu
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=rebyu
DB_USERNAME=postgres
DB_PASSWORD=replace_me

# --- AWS / Cognito (required) ---
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_YhXCAZ9HF
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_YhXCAZ9HF

# --- Mail (required) ---
GOOGLE_APP_PASS=replace_me

# --- RabbitMQ ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Python AI service ---
AI_SERVICE_URL=http://localhost:8000/api/v1/ai
AI_SERVICE_API_KEY=
AI_CONNECT_TIMEOUT=5000
AI_READ_TIMEOUT=120000

# --- BKT service ---
BKT_ENABLED=true
BKT_SERVICE_URL=http://localhost:8000/api/v1/bkt
BKT_SERVICE_API_KEY=
BKT_CONNECT_TIMEOUT=2000
BKT_READ_TIMEOUT=5000
BKT_MAX_RETRIES=8
BKT_RETRY_INITIAL_DELAY=15
BKT_RETRY_MAX_DELAY=3600
BKT_DISPATCH_INTERVAL=10000
BKT_DISPATCH_INITIAL_DELAY=15000
BKT_DISPATCH_BATCH_SIZE=100
BKT_RECONCILIATION_INTERVAL=900000
BKT_RECONCILIATION_INITIAL_DELAY=60000
BKT_RECONCILIATION_BATCH_SIZE=200
BKT_PARTIAL_CREDIT_CORRECT_THRESHOLD=0.60
BKT_FALLBACK_ASSESSMENT_TYPE=LESSON_QUIZ
BKT_FALLBACK_DIFFICULTY=AVERAGE

# --- Judge0 (code execution) ---
JUDGE0_ENABLED=true
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_KEY_HEADER=X-RapidAPI-Key
JUDGE0_CONNECT_TIMEOUT=5000
JUDGE0_READ_TIMEOUT=20000
JUDGE0_CPU_TIME_LIMIT=5
JUDGE0_MEMORY_LIMIT=128000

# --- PayMongo (billing) ---
PAYMONGO_ENABLED=false
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# --- Feature flags / adaptive retake ---
MOCK_EXAM_REQUIRES_ENTITLEMENT=false
RETAKE_ADAPTIVE_ENABLED=true
RETAKE_MIN_EVIDENCE_PER_CELL=2
RETAKE_WEAK_ACCURACY_THRESHOLD=0.70
RETAKE_WEAK_BOOST_FACTOR=1.5
RETAKE_STRONG_ACCURACY_THRESHOLD=0.85
RETAKE_STRONG_REDUCTION_FACTOR=0.5
