# Copy this file to backend-java/.env locally if your environment loader supports it.
# Do not commit backend-java/.env. Spring Boot can also receive these values directly
# from your shell, IDE run configuration, or deployment environment.
PAYMONGO_ENABLED=true
PAYMONGO_SECRET_KEY=replace_with_your_paymongo_test_secret_key
PAYMONGO_PUBLIC_KEY=replace_with_your_paymongo_test_public_key
