APP_NAME=Rebyu BKT Service
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1/bkt
SERVICE_API_KEY=replace-with-a-long-random-internal-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_SCHEMA=bkt

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_ALWAYS_EAGER=false
TIMEZONE=Asia/Manila
SCHEDULED_RETRAINING_ENABLED=true
SCHEDULED_RETRAINING_DAY_OF_WEEK=sun
SCHEDULED_RETRAINING_HOUR=2
SCHEDULED_RETRAINING_MINUTE=0

ARTIFACT_DIR=/app/artifacts
TRAINING_VIEW_NAME=rebyu_bkt_training_data_v
MAX_UPLOAD_MB=100

BKT_SEED=42
BKT_NUM_FITS=2
BKT_TEST_SIZE=0.20
BKT_MIN_INTERACTIONS_PER_SKILL=20
BKT_MIN_LEARNERS_PER_SKILL=3

FALLBACK_PRIOR=0.30
FALLBACK_LEARN=0.20
FALLBACK_GUESS=0.25
FALLBACK_SLIP=0.10
FALLBACK_FORGET=0.00

DEVELOPING_THRESHOLD=0.40
GOOD_THRESHOLD=0.70
MASTERED_THRESHOLD=0.85

# Readiness weights. List every component and keep the total at exactly 1.00 --
# the service divides by whatever the weights actually sum to, so a partial list
# does not fail, it just silently scales every weight down. That is how an
# earlier version of this block ended up claiming mastery was 0.60 while it ran
# at 0.46: two components had been added to the service and never listed here.
# If you add a component, add it here too and rebalance.
READINESS_MASTERY_WEIGHT=0.46
READINESS_PROGRESS_WEIGHT=0.15
READINESS_QUIZ_WEIGHT=0.12
READINESS_MOCK_EXAM_WEIGHT=0.08
READINESS_MIDDLE_EXAM_WEIGHT=0.08
READINESS_MAJOR_EXAM_WEIGHT=0.06
READINESS_DIAGNOSTIC_WEIGHT=0.04
READINESS_STREAK_WEIGHT=0.01

# Priority scoring (lesson component weights; normalized when a component is absent)
PRIORITY_WEIGHT_MASTERY=0.45
PRIORITY_WEIGHT_INCORRECT=0.20
PRIORITY_WEIGHT_MOCK=0.10
PRIORITY_WEIGHT_DIAGNOSTIC=0.10
PRIORITY_WEIGHT_CURRICULUM=0.10
PRIORITY_WEIGHT_REVIEW=0.05

# Priority tag thresholds (0..100)
PRIORITY_CRITICAL_THRESHOLD=85
PRIORITY_HIGH_THRESHOLD=70
PRIORITY_MEDIUM_THRESHOLD=50
PRIORITY_LOW_THRESHOLD=30
PRIORITY_ON_TRACK_THRESHOLD=15

# Mastery safeguards + stabilization hysteresis
PRIORITY_MIN_EVIDENCE=1
MASTERY_CRITICAL_CEILING=0.20
MASTERY_HIGH_CEILING=0.30
PRIORITY_WORSEN_MARGIN=5
PRIORITY_IMPROVE_MARGIN=8

# RabbitMQ (Phase 6) -- same broker the Java backend's producers publish to
# (rebyu.exchange topic exchange + rebyu.dlx dead-letter exchange).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=rebyu.exchange
RABBITMQ_DEAD_LETTER_EXCHANGE=rebyu.dlx

# AWS S3 (Phase 6) -- reads knowledge_documents files Java uploaded, same
# bucket/region as backend-java's S3Config.
AWS_S3_BUCKET_NAME=rebyu
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# This service can safely share the main Rebyu Neon database with the Java
# backend: every BKT table lives in its own Postgres schema (DB_SCHEMA, default
# "bkt"), created automatically on first `alembic upgrade head`. Set
# DATABASE_URL to the SAME connection string Java uses (translated to
# postgresql+psycopg://...), not a separate database. This avoids colliding
# with Java's own tables -- notably a legacy `learner_lesson_mastery` table
# that already exists in `public` from the old progress package.

# --- AI provider keys --------------------------------------------------------
# Tasks are split across providers by which free tier fits them. Set a key for
# every provider some task uses; a missing one fails fast at startup naming the
# task and the provider rather than dying inside an HTTP call.
#
#   Gemini      https://aistudio.google.com/apikey   free, no card
#   Groq        https://console.groq.com/keys        free
#   OpenRouter  https://openrouter.ai/keys           optional; widest catalogue
GEMINI_API_KEY=
GROQ_API_KEY=
OPEN_ROUTER_KEY=
#OPENROUTER_SITE_URL=https://rebyu.app
#OPENROUTER_APP_NAME=REBYU

# --- Per-task AI models ------------------------------------------------------
# One provider AND model per task, not one model per tier. These jobs differ by
# more than an order of magnitude, so a single model either wastes the biggest
# model on a boolean or underpowers the lessons.
#
# The defaults run entirely on GROQ. Gemini is configured as a provider and its
# key works, but it cannot serve the two agents that matter most here: `lesson`
# and `curriculum` call a Serper web search and then answer, i.e. MULTI-TURN tool
# use, and Gemini 3.x requires a `thought_signature` on replayed tool calls that
# the OpenAI-compatibility layer drops (400 INVALID_ARGUMENT). Tested 2026-08-03:
#
#   PASS  groq llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3.6-27b
#   PASS  openrouter nvidia/nemotron-3-ultra-550b-a55b:free  (50 req/day, though)
#   FAIL  gemini 3.x        -- thought_signature
#   FAIL  groq gpt-oss-*    -- tool_use_failed WITH tools; fine without, which is
#                              why the question agent still runs on gpt-oss-120b
#
# Gemini remains the right home for any future agent that needs a big token
# budget and NO tools -- its ~250k TPM dwarfs Groq's 6-12k.
#
# Fallbacks must stay inside the task's provider: a slug only means something to
# the provider serving it (`llama-3.3-70b-versatile` is Groq's name for what
# OpenRouter calls `meta-llama/llama-3.3-70b-instruct`).
#
# Values shown are the defaults -- uncomment only to change one.
#AI_LESSON_PROVIDER=groq
#AI_LESSON_MODEL=llama-3.3-70b-versatile
#AI_LESSON_FALLBACKS=qwen/qwen3.6-27b,llama-3.1-8b-instant
#AI_LESSON_MAX_TOKENS=8000
#AI_LESSON_TEMPERATURE=0.4

#AI_CURRICULUM_PROVIDER=groq
#AI_CURRICULUM_MODEL=llama-3.3-70b-versatile
#AI_CURRICULUM_FALLBACKS=qwen/qwen3.6-27b
#AI_CURRICULUM_MAX_TOKENS=8000
#AI_CURRICULUM_TEMPERATURE=0.2

# The volume task -- dozens of calls per certification. Budget and batch size
# move together: one MCQ costs ~250 completion tokens, so batch * 250 must stay
# under the budget or responses truncate. A test pins this.
#AI_QUESTION_PROVIDER=groq
#AI_QUESTION_MODEL=openai/gpt-oss-120b
#AI_QUESTION_FALLBACKS=llama-3.3-70b-versatile,llama-3.1-8b-instant
#AI_QUESTION_MAX_TOKENS=4000
#AI_QUESTION_TEMPERATURE=0.6
#QUESTION_BATCH_SIZE=15

#AI_TUTOR_PROVIDER=groq
#AI_TUTOR_MODEL=llama-3.1-8b-instant
#AI_TUTOR_FALLBACKS=openai/gpt-oss-20b
#AI_TUTOR_MAX_TOKENS=2000

#AI_LESSON_AUDIT_PROVIDER=groq
#AI_LESSON_AUDIT_MODEL=llama-3.3-70b-versatile
#AI_LESSON_AUDIT_FALLBACKS=llama-3.1-8b-instant
#AI_LESSON_AUDIT_MAX_TOKENS=1024

#AI_DOCUMENT_AUDIT_PROVIDER=groq
#AI_DOCUMENT_AUDIT_MODEL=llama-3.1-8b-instant
#AI_DOCUMENT_AUDIT_FALLBACKS=openai/gpt-oss-20b
#AI_DOCUMENT_AUDIT_MAX_TOKENS=512

# Skip window after a rate-limit response with no parseable reset time.
#AI_QUOTA_COOLDOWN_SECONDS=3600

# --- Paid profile (best lessons; needs OpenRouter credit) ---------------------
# Removes every daily cap and raises lesson quality. Roughly $2-3 per
# certification, or ~$0.25 using Llama throughout (llama-4-scout is ~8x cheaper
# per output token than Gemini Flash).
#
# CAUTION on Llama for lessons/curriculum: `llama-3.3-70b` is the model this
# codebase did three rounds of schema surgery for -- it lost bracket-tracking on
# large structured outputs, which is why the curriculum agent answers in plain
# JSON at all (app/ai/json_output.py). Llama 4 is a different architecture and
# may be fine, but verify a real lesson before trusting a batch run.
#
#AI_LESSON_PROVIDER=openrouter
#AI_LESSON_MODEL=anthropic/claude-sonnet-4.5
#AI_LESSON_FALLBACKS=google/gemini-2.5-pro,openai/gpt-4.1-mini
#AI_CURRICULUM_PROVIDER=openrouter
#AI_CURRICULUM_MODEL=google/gemini-2.5-pro
#AI_QUESTION_PROVIDER=openrouter
#AI_QUESTION_MODEL=meta-llama/llama-4-scout
#AI_QUESTION_MAX_TOKENS=8000

# --- Curriculum / assessment size ------------------------------------------
# What the planner is asked to produce, and how many questions each assessment
# gets. Defaults shown; uncomment and lower to run the whole workflow on a
# small AI budget. Setting every curriculum min/max to 1 yields a
# one-major/one-middle/one-lesson certification that still exercises every
# node in the graph -- review checkpoints and assessments included.
#
# The breadth floor that rejects an under-sized curriculum is derived from
# these, so a deliberately minimal run is not resampled as a bad sample.
#CURRICULUM_MIN_MAJORS=3
#CURRICULUM_MAX_MAJORS=6
#CURRICULUM_MIN_MIDDLES=2
#CURRICULUM_MAX_MIDDLES=4
#CURRICULUM_MIN_LESSONS=3
#CURRICULUM_MAX_LESSONS=5

# Content blocks per lesson. Independent of curriculum size on purpose: a
# cheap test run wants few lessons, not thin ones. Bounded by
# AI_LESSON_MAX_TOKENS -- the whole lesson is written in one response, so
# raising this without raising that produces truncated (and then discarded)
# lessons.
#LESSON_MIN_SECTIONS=18

# Questions asked for in one call; larger asks are split and merged. Keep this
# below AI_QUESTION_MAX_TOKENS / 250 -- one MCQ costs ~250 completion tokens
# because it explains every choice, and exceeding the budget truncates the
# response, which fails, retries, and eventually trips the Java gateway's
# 120s read timeout.
#QUESTION_BATCH_SIZE=20

# Questions per assessment. These dominate a run's token cost -- 280 questions
# at these defaults regardless of how small the curriculum is -- so they are
# the first thing to lower when the budget is the constraint.
#LESSON_QUIZ_QUESTIONS=10
#MIDDLE_QUIZ_QUESTIONS=20
#MAJOR_QUIZ_QUESTIONS=50
#DIAGNOSTIC_EXAM_QUESTIONS=40
#MOCK_EXAM_QUESTIONS=60
#QUESTION_BANK_QUESTIONS=100

# Ceiling on the mock exam regardless of the exam structure the planner
# researched (TOPCIT's real paper is 100 items). 0 = no ceiling.
#MOCK_EXAM_MAX_QUESTIONS=0
